includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first
    # time it runs, and parallel workers each start that install at once on a
    # fresh checkout (CI), failing with Install\StepFailed.
    parallel:
        maximumNumberOfProcesses: 1
    level: 6
    paths:
        - extend.php
        - src
    databaseMigrationsPath: [migrations]
    # Optional extensions this one integrates with only while they're enabled.
    excludePaths:
        - src/Integration/DocketCrowd.php
        - src/Integration/OnrampStep.php
        - src/Integration/Optional.php
